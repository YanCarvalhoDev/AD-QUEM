---
import Header from '../components/Header';
import Footer from '../components/Footer';
import WhatsAppButton from '../components/WhatsAppButton';
import ProgressIndicator from '../components/ProgressIndicator';
import '../styles/global.css';

interface Props {
  title?: string;
  isDarkPage?: boolean;
  className?: string;
}

const { 
  title = "AD QUEM | Autoridade para o Mercado Jurídico", 
  isDarkPage = true, 
  className = "bg-teal-deep" 
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link 
      rel="preload" 
      href="/fonts/inter-v20-latin-regular.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link 
      rel="preload" 
      href="/fonts/instrument-serif-v5-latin-regular.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    
    <title>{title}</title>
    <meta name="description" content="A Ad Quem desenvolve estratégias, experiências e estruturas digitais para bancas de advocacia que desejam fortalecer sua presença, reputação e autoridade." />
    <meta name="keywords" content="engenharia de software jurídico, arquiteto digital, tecnologia para advogados, automação jurídica, software sob medida, bancas boutique" />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Estratégia, tecnologia e conteúdo para fortalecer a presença e a autoridade de bancas de advocacia." />
    <meta property="og:image" content="/AQ_logo_g.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content="A Ad Quem desenvolve estratégias, experiências e estruturas digitais para bancas de advocacia que desejam fortalecer sua presença, reputação e autoridade." />
    <meta property="twitter:image" content="/AQ_logo_g.png" />

    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "AdQuem",
  "description": "A Ad Quem desenvolve estratégias, experiências e estruturas digitais para bancas de advocacia que desejam fortalecer sua presença, reputação e autoridade.",
  "image": "/AQ_logo_g.png",
  "url": "https://www.adquem.com.br",
  "priceRange": "R$ 2.000,00+",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-23.5505",
    "longitude": "-46.6333"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "São Paulo",
    "addressRegion": "SP",
    "addressCountry": "BR"
  },
  "areaServed": [
    {
      "@type": "Country",
      "name": "Brasil"
    },
    {
      "@type": "City",
      "name": "São Paulo",
      "description": "Centro estratégico de atendimento para bancas de alto padrão."
    }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": "08:00",
    "closes": "20:00"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços da Ad Quem",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Diagnóstico e Arquitetura Digital",
          "description": "Análise do posicionamento, serviços, objetivos e estrutura digital da banca para definir uma presença alinhada à sua autoridade e às suas necessidades."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Identidade e Experiência Digital",
          "description": "Desenvolvimento de uma experiência visual alinhada à identidade, reputação e posicionamento da banca, com foco em clareza, confiança e diferenciação."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desenvolvimento e Infraestrutura",
          "description": "Desenvolvimento de sites e estruturas digitais com foco em performance, segurança, acessibilidade, mecanismos de busca e novas formas de descoberta digital."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Conteúdo e Evolução Digital",
          "description": "Estruturação da presença digital para publicação de conhecimento, artigos, conteúdos especializados e evolução contínua da banca."
        }
      }
    ]
  }
}
</script>

  </head>
  <body class={`min-h-screen selection:bg-gold-pale selection:text-teal-deep ${className}`}>
  <!--  <ProgressIndicator client:idle /> -->
    
  <Header isDarkPage={isDarkPage} client:idle /> 
    
    <main>
      <slot />
    </main>

    <Footer client:visible />
    <!-- <WhatsAppButton client:visible /> -->
  </body>
</html>

<style is:global>
  :root {
    --accent: #C0B283;
  }
</style>