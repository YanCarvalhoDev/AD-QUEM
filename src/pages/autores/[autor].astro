---
// src/pages/autores/[autor].astro
import { getCollection } from 'astro:content';
import { Clock, Calendar, Share2, ArrowLeft } from 'lucide-react';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ProgressIndicator from '../../components/ProgressIndicator';
import '../../styles/global.css';

export async function getStaticPaths() {
  const autores = await getCollection('autores');
  return autores.map((autor) => ({
    params: { autor: autor.id },
    props: { autor },
  }));
}

const { autor } = Astro.props;

if (!autor) {
  return Astro.redirect('/404');
}

const {
  name,
  role,
  oab,
  image,
  bio,
  knowsAbout,
  linkedin,
  instagram,
  email,
  jusbrasil,
  whatsapp,
  tiktok,
  site,
  twitter,
  threads,
  facebook,
  youtube,
  cnpq,
} = autor.data;

// 1. Busca todos os artigos para filtrar os que este autor participou
const todosArtigos = await getCollection('artigos');

// 2. Filtra os artigos do autor e ordena de forma decrescente (mais recente primeiro)
const artigosDoAutor = todosArtigos
  .filter((artigo) => artigo.data.authors?.includes(autor.id))
  .sort((a, b) => {
    const dataA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dataB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dataB - dataA;
  });

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.adquem.com.br');

// 3. Resolução da foto principal vertical do autor
let fotoSrc = "";
if (image) {
  fotoSrc = typeof image === 'string' ? image : image.src || "";
}

// Limpa o número do WhatsApp para o link da API
const whatsappLimpo = whatsapp ? whatsapp.replace(/\D/g, '') : '';
const linkWhatsapp = whatsappLimpo ? `https://wa.me/55${whatsappLimpo}` : null;

const metaTitle = `${name} | ${role} | Corpo Técnico AdQuem`;
const metaDescription = bio ?? `Conheça a trajetória, especialidades e publicações de ${name} na AdQuem.`;

// Redes sociais higienizadas para o sameAs
const redesSociais = [linkedin, instagram, linkWhatsapp, jusbrasil, tiktok, twitter, threads, facebook, youtube, cnpq].filter(Boolean);

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": name,
    "jobTitle": role || "Autor",
    "image": fotoSrc,
    ...(bio && { "description": bio }),
    ...(email && { "email": email }),
    ...(site && { "url": site }),
    ...(knowsAbout && knowsAbout.length > 0 && { "knowsAbout": knowsAbout }),
    ...(redesSociais.length > 0 && { "sameAs": redesSociais }),
    ...(oab && {
      "identifier": {
        "@type": "PropertyValue",
        "name": "OAB",
        "value": oab
      }
    })
  },
  "publisher": {
    "@type": "Organization",
    "name": "AdQuem",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.adquem.com.br/AQ_logo_g.png"
    }
  },
  "url": canonicalURL.href,
  "inLanguage": "pt-BR"
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preload" href="/fonts/inter-v20-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-v5-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    {fotoSrc && <meta property="og:image" content={fotoSrc} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="AdQuem" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  
  <body class="min-h-screen selection:bg-gold-pale selection:text-teal-deep bg-teal-deep">
    <ProgressIndicator client:idle />
    
    <Header isDarkPage={true} client:idle />
    
    <main>
      <div class="min-h-screen bg-white font-sans selection:bg-[#E6F4F6] text-black">
        <div class="pb-32">

          <!-- Header da Seção Ultra-Compacto -->
          <div class="bg-[#002B30] pt-28 pb-8 mb-12 relative overflow-hidden print:hidden">
            <div class="absolute top-0 right-0 w-1/3 h-full bg-[#C5A880]/5 blur-[120px] rounded-full translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
            <div class="container mx-auto max-w-6xl px-6 lg:px-20 relative z-10">
              <nav class="flex items-center justify-between border-b border-white/10 pb-4">
                <a href="/autores" class="flex items-center gap-2 text-white hover:text-[#C5A880] transition-colors group">
                  <ArrowLeft size={14} class="group-hover:-translate-x-1 transition-transform" />
                  <span class="text-[11px] font-bold uppercase tracking-[0.2em]">
                    Ver Especialistas
                  </span>
                </a>

                <div class="flex items-center gap-4 text-white/60">
                  
                  <div class="w-px h-3 bg-white/20"></div>
                  <span class="text-[10px] font-bold text-white/40 uppercase tracking-widest">
                    {name.toUpperCase()}
                  </span>
                </div>
              </nav>
            </div>
          </div>
          
          <!-- Grid Principal do Perfil -->
          <div class="container mx-auto max-w-7xl px-6 lg:px-20">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

              <!-- Coluna de Identificação (Foto/Redes) -->
              <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-32">
                
                <!-- Card Container da Foto -->
                <div class="relative aspect-[3/4] md:aspect-[4/5] lg:aspect-[2/3] rounded-[24px] lg:rounded-[32px] overflow-hidden border border-gray-100 shadow-sm bg-gray-50 group">
                  {image ? (
                    <img
                      src={fotoSrc}
                      alt={name}
                      class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-103"
                      loading="eager"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-[#005F6B]/5 text-[#005F6B]">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                  )}
                </div>

                <!-- Nome e Título Móvel (Apenas visível abaixo do card no mobile) -->
                <div class="block lg:hidden text-center mt-4">
                  <h1 class="text-3xl font-bold text-[#002B30] tracking-wide mb-1">
                    {name}
                  </h1>
                  <p class="text-md font-medium text-[#C5A880] tracking-tight mb-2">
                    {role}
                  </p>
                  {oab && (
                    <span class="inline-block text-[11px] font-mono tracking-widest text-[#005F6B] bg-[#005F6B]/5 px-3 py-1 rounded">
                      OAB: {oab}
                    </span>
                  )}
                  {site && (
                      <a href={site} target="_blank" rel="noopener noreferrer" class="inline-block text-[11px] font-mono tracking-widest text-[#005F6B] bg-[#005F6B]/5 px-3 py-1 rounded hover:bg-[#002B30] hover:text-white transition-colors duration-200">
                        {site.replace(/^(https?:\/\/)?(www\.)?/, '')}
                      </a>
                    )}
                    {cnpq && (
                    <a href={cnpq} target="_blank" rel="noopener noreferrer" class="inline-block text-[11px] font-mono tracking-widest text-[#005F6B] bg-[#005F6B]/5 px-3 py-1 rounded hover:bg-[#002B30] hover:text-white transition-colors duration-200">
                      {cnpq.replace(/^(https?:\/\/)?(www\.)?/, '')}
                    </a>
                  )}
                </div>

                <!-- Redes Sociais com Espaçamento Justificado (Mobile ocupa o tamanho do card) -->
                <div class="flex items-center justify-between lg:justify-start lg:gap-3 pt-2 w-full">
                  {linkedin && (
                    <a href={linkedin} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="LinkedIn">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                  )}
                  {instagram && (
                    <a href={instagram} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="Instagram">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                    </a>
                  )}
                  {email && (
                    <a href={`mailto:${email}`} class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="E-mail">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </a>
                  )}
                  {jusbrasil && (
                    <a href={jusbrasil} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="Jusbrasil">
                      <svg xmlns="http://w3.org" viewBox="0 0 24 24" class="w-5 h-5 fill-current">
                        <path d="M12 3.5L3.5 18.5H7.5L12 10.5L16.5 18.5H20.5L12 3.5Z" />
                        <path opacity="0.5" d="M12 3.5L9.5 7.5L12 12L14.5 7.5L12 3.5Z" />
                      </svg>
                    </a>
                  )}
                  {linkWhatsapp && ( <a href={linkWhatsapp} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 hover:bg-emerald-600 hover:text-white transition-all duration-300" title="WhatsApp Direct"> <svg xmlns="http://w3.org" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path><path d="M16 12A3 3 0 0 1 13 9l-.3-.3a1 1 0 0 0-1.4 0l-1.6 1.6a1 1 0 0 1-1.4 0l-1.6-1.6a1 1 0 0 1 0-1.4l1.6-1.6a1 1 0 0 0 0-1.4L8 4A3 3 0 0 0 5 7a8 8 0 0 0 11 11v-6z" opacity="0"></path><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1zm0 0a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a4 4 0 0 1-4-4V9z"></path></svg> </a> )}

                </div>
              </div>

              <!-- Biografia e Artigos Relacionados (Direita) -->
              <div class="lg:col-span-8 space-y-12">
                
                <!-- Identificação Principal Desktop (Oculta no Mobile para evitar duplicação) -->
                <div class="hidden lg:block">
                  <h1 class="text-4xl lg:text-[52px] font-bold text-[#002B30] leading-tight tracking-wide mb-3">
                    {name}
                  </h1>
                  <p class="text-lg font-medium text-[#C5A880] tracking-wide mb-2">
                    {role}
                  </p>
                  <div class="flex items-center gap-2">
                  {oab && (
                    <span class="inline-block text-[11px] font-mono tracking-widest text-[#005F6B] bg-[#005F6B]/5 px-3 py-1 rounded">
                      OAB: {oab}
                    </span>
                  )}
                  {site && (
                    <a href={site} target="_blank" rel="noopener noreferrer" class="inline-block text-[11px] font-mono tracking-widest text-[#005F6B] bg-[#005F6B]/5 px-3 py-1 rounded hover:bg-[#002B30] hover:text-white transition-colors duration-200">
                      {site.replace(/^(https?:\/\/)?(www\.)?/, '')}
                    </a>
                  )}
                  {cnpq && (
                    <a href={cnpq} target="_blank" rel="noopener noreferrer" class="inline-block text-[11px] font-mono tracking-widest text-[#005F6B] bg-[#005F6B]/5 px-3 py-1 rounded hover:bg-[#002B30] hover:text-white transition-colors duration-200">
                      {cnpq.replace(/^(https?:\/\/)?(www\.)?/, '')}
                    </a>
                  )}
                </div>

                </div>

                <!-- Biografia Longa -->
                {bio && (
                  <div class="prose max-w-none border-t lg:border-t-0 border-gray-100 pt-6 lg:pt-0">
                    <p class="text-gray-600 text-lg leading-[1.8] font-light whitespace-pre-line">
                      {bio}
                    </p>
                  </div>
                )}

                <!-- Áreas de Foco / Especialidades -->
                {knowsAbout && knowsAbout.length > 0 && (
                  <div class="border-t border-gray-100 pt-8">
                    <h3 class="text-[11px] font-bold text-[#002B30] uppercase tracking-[0.25em] mb-4 text-center sm:text-left">
                      Especialidades & Foco Técnico
                    </h3>
                    <div class="flex flex-wrap justify-center sm:justify-start gap-2">
                      {knowsAbout.map((tag) => (
                        <span class="px-4 py-1.5 bg-gray-50 text-gray-500 text-xs rounded-full border border-gray-100/60 font-medium">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Artigos Produzidos pelo Autor -->
                <div class="border-t border-gray-100 pt-10">
                  <h3 class="text-xl font-bold text-[#002B30] tracking-wide mb-6 text-center sm:text-left">
                    Artigos e Análises Publicadas ({artigosDoAutor.length})
                  </h3>

                  {artigosDoAutor.length === 0 ? (
                    <p class="text-gray-400 text-sm font-light italic text-center sm:text-left">
                      Este profissional ainda não possui artigos publicados nesta plataforma.
                    </p>
                  ) : (
                    <div class="space-y-6">
                      {artigosDoAutor.map((artigo) => {
                        const dataFormatada = artigo.data.date
                          ? new Intl.DateTimeFormat('pt-BR', {
                              day: '2-digit',
                              month: 'short',
                              year: 'numeric',
                              timeZone: 'UTC',
                            }).format(new Date(artigo.data.date))
                          : '';

                        return (
                          <a 
                            href={`/blog/${artigo.id}`} 
                            class="group block p-6 bg-white rounded-2xl border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-md transition-all duration-300"
                          >
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                              <div class="space-y-1.5">
                                <span class="text-[10px] font-bold text-[#005F6B] uppercase tracking-widest block">
                                  {artigo.data.category}
                                </span>
                                <h4 class="text-xl font-bold text-[#002B30] group-hover:text-[#C5A880] transition-colors leading-tight tracking-wide">
                                  {artigo.data.title}
                                </h4>
                                {artigo.data.subtitle && (
                                  <p class="text-sm text-gray-400 line-clamp-2 font-light">
                                    {artigo.data.subtitle}
                                  </p>
                                )}
                              </div>
                              
                              <div class="flex sm:flex-col items-center sm:items-end gap-4 sm:gap-1 shrink-0 text-gray-400 text-xs font-mono border-t sm:border-t-0 pt-3 sm:pt-0 border-gray-50">
                                <span class="flex items-center gap-1">
                                  <Calendar size={12} /> {dataFormatada}
                                </span>
                                <span class="hidden sm:inline w-1 h-1 rounded-full bg-gray-200 my-1"></span>
                                <span class="flex items-center gap-1">
                                  <Clock size={12} /> {artigo.data.readingTime || "5 min"}
                                </span>
                              </div>
                            </div>
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>

              </div>
            </div>
          </div>

        </div>
        <div class="flex items-center justify-center flex-wrap gap-3 pb-4">

          {tiktok && (
            <a href={tiktok} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="TikTok">
              <svg xmlns="http://w3.org" viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M12.525.02c1.31.01 2.57.42 3.61 1.17.65.48 1.19 1.12 1.58 1.86.35-.01.7-.02 1.05-.02V6.2c-.89-.03-1.76-.32-2.5-.83-.49-.34-.91-.77-1.22-1.28v7.54c0 3.31-2.48 6.07-5.69 6.29-3.56.24-6.6-2.44-6.64-6.01-.04-3.21 2.37-5.93 5.57-6.13.23-.01.47-.01.7 0v3.17c-.17-.03-.35-.04-.53-.04-1.66 0-3.01 1.35-3.01 3.01s1.35 3.01 3.01 3.01 3.01-1.35 3.01-3.01V0h3.07z"/></svg>
            </a>
          )}

          {twitter && (
            <a href={twitter} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="X">
              <svg xmlns="http://w3.org" viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          )}

          {threads && (
            <a href={threads} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="Threads">
              <span class="w-5 h-5 flex items-center justify-center text-base font-bold font-sans antialiased fill-current">
  @
</span>

            </a>
          )}

          {facebook && (
            <a href={facebook} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="Facebook">
              <svg xmlns="http://w3.org" viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12z"/></svg>
            </a>
          )}

          {youtube && (
            <a href={youtube} target="_blank" rel="noopener noreferrer" class="w-12 h-12 lg:w-10 lg:h-10 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="YouTube">
              <svg xmlns="http://w3.org" viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.516 0-9.387.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.503 5.837a3.003 3.003 0 0 0 2.11 2.11c1.871.507 9.387.507 9.387.507s7.517 0 9.387-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          )}
        </div>

      </div>
    </main>

    <Footer client:visible />
  </body>
</html>

<style is:global>
  :root {
    --accent: #C0B283;
  }
</style>

<script>
  const btnShare = document.getElementById("btn-share");
  if (btnShare) {
    btnShare.addEventListener("click", async () => {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
      } catch {
        navigator.clipboard.writeText(window.location.href);
        alert("Link do perfil copiado para a área de transferência!");
      }
    });
  }
</script>