---
// src/pages/autores/index.astro
import '../../styles/global.css';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ProgressIndicator from '../../components/ProgressIndicator';

// Usando o Content Layer nativo do Astro
import { getCollection } from 'astro:content';

// 1. Busca a coleção diretamente usando as definições do seu content.config.ts
const todosAutores = await getCollection('autores');

// 2. Mapeia e higieniza os dados diretamente do cache do Astro
const autoresProntos = todosAutores.map((item) => {
  const autor = item.data;

  // Resolução dinâmica de imagem idêntica ao restante do ecossistema AdQuem
  let fotoUrl = "";
  if (autor.image) {
    if (typeof autor.image === 'string') {
      fotoUrl = autor.image.startsWith('http')
        ? autor.image
        : new URL(autor.image, Astro.site || 'https://www.adquem.com.br').toString();
    } else if (autor.image.src) {
      const srcEstatico = typeof autor.image.src === 'string' ? autor.image.src : (autor.image.src as any).src || '';
      if (srcEstatico) {
        const caminhoBuildado = srcEstatico.split('?')[0];
        const dominioProducao = 'https://www.adquem.com.br';
        fotoUrl = caminhoBuildado.startsWith('http')
          ? caminhoBuildado
          : `${dominioProducao}${caminhoBuildado.startsWith('/') ? '' : '/'}${caminhoBuildado}`;
      }
    }
  }

  return {
    slug: item.id, // O Content Layer injeta o ID/Slug automaticamente aqui
    name: autor.name,
    role: autor.role || "Advogado Especialista",
    oab: autor.oab || null,
    bio: autor.bio || "",
    featured: autor.featured || false,
    especialidades: autor.knowsAbout || [],
    foto: autor.image || null, 
    fotoAbsoluta: fotoUrl,
    redes: {
      linkedin: autor.linkedin || null,
      instagram: autor.instagram || null,
      email: autor.email ? `mailto:${autor.email}` : null,
      jusbrasil: autor.jusbrasil || null,
    }
  };
});

// 3. Ordena os autores em destaque primeiro
const autoresOrdenados = autoresProntos.sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return a.name.localeCompare(b.name);
});

// 🌟 CONFIGURAÇÃO DE SEO E META TAGS DOS AUTORES 🌟
const metaTitle = "Corpo Técnico e Especialistas | AdQuem";
const metaDescription = "Conheça os especialistas e o corpo técnico por trás das nossas análises estratégicas, artigos de engenharia de performance e inteligência jurídica boutique.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://www.adquem.com.br");
const ogImage = "https://www.adquem.com.br/og-image.jpg"; 

// Coleta todas as especialidades únicas do time para gerar palavras-chave dinâmicas
const todasEspecialidades = autoresProntos.flatMap(a => a.especialidades);
const keywordsDinamicas = [...new Set(todasEspecialidades)].join(", ");

// ======================================================
// 📑 SCHEMA MARKUP COMPLETO (ItemPage + ItemList)
// ======================================================
const autoresSchema = {
  "@context": "https://schema.org",
  "@type": "ItemPage",
  "@id": canonicalURL.href,
  "headline": metaTitle,
  "description": metaDescription,
  "url": canonicalURL.href,
  "inLanguage": "pt-BR",
  "mainEntity": {
    "@type": "ItemList",
    "name": "Especialistas AdQuem",
    "numberOfItems": autoresOrdenados.length,
    "itemListElement": autoresOrdenados.map((autor, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Person",
        "name": autor.name,
        "jobTitle": autor.role,
        "url": `${canonicalURL.origin}/autores/${autor.slug}`,
        ...(autor.fotoAbsoluta && { "image": autor.fotoAbsoluta }),
        ...(autor.bio && { "description": autor.bio }),
        ...(autor.especialidades.length > 0 && { "knowsAbout": autor.especialidades }),
        ...((autor.redes.linkedin || autor.redes.instagram || autor.redes.jusbrasil) && {
          "sameAs": [autor.redes.linkedin, autor.redes.instagram, autor.redes.jusbrasil].filter(Boolean)
        })
      }
    }))
  },
  "publisher": {
    "@type": "Organization",
    "name": "AdQuem",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.adquem.com.br/logo.png"
    }
  }
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preload" href="/fonts/inter-v20-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-v5-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {keywordsDinamicas && <meta name="keywords" content={keywordsDinamicas} />}
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="AdQuem" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(autoresSchema)} />
  </head>
  
  <body class="min-h-screen selection:bg-gold-pale selection:text-teal-deep bg-teal-deep">
    <ProgressIndicator client:idle />
    
    <Header isDarkPage={true} client:idle />
    
    <main>
      <div class="min-h-screen bg-white font-sans text-black">
        
        <section class="bg-[#002B30] pt-48 pb-24 px-6 lg:px-20 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-1/3 h-full bg-[#C5A880]/5 blur-[120px] rounded-full translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
          <div class="container mx-auto max-w-6xl relative z-10">
            <span class="text-[#C5A880] font-mono text-xs tracking-[0.3em] uppercase mb-6 block font-bold">
              Quiet Authority
            </span>
            <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold leading-tight mb-8 text-white">
              Nossos <br />
              <span class="text-[#C5A880] italic font-normal font-serif">Especialistas</span>
            </h1>
            <p class="text-xl text-white/60 leading-relaxed max-w-2xl font-light tracking-wide">
              Conectamos a precisão técnica do direito corporativo de alta performance à inteligência estratégica das marcas de luxo.
            </p>
          </div>
        </section>

        <section class="container mx-auto max-w-6xl px-6 lg:px-20 pt-20 pb-32">
          {autoresOrdenados.length === 0 ? (
            <div class="text-center py-20 border border-dashed border-gray-100 rounded-[32px]">
              <p class="text-gray-400 font-medium">Nenhum autor cadastrado no sistema.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-20">
              {autoresOrdenados.map((autor) => (
                <div class="group flex flex-col justify-between bg-white rounded-[32px] border border-gray-100 p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300 relative">
                  
                  {autor.featured && (
                    <div class="absolute top-6 right-6 flex items-center gap-1.5 px-3 py-1 bg-[#C5A880]/10 text-[#C5A880] rounded-full text-[10px] font-bold uppercase tracking-wider z-20">
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 9.7a1 1 0 0 1-.68 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 .76-.97l8-2a1 1 0 0 1 .48 0l8 2A1 1 0 0 1 20 6z"/></svg>
                      Destaque
                    </div>
                  )}

                  <div>
                    <div class="flex flex-col sm:flex-row sm:items-center gap-6 mb-8">
                      
                      <div class="w-24 h-24 sm:w-20 sm:h-20 rounded-full overflow-hidden bg-gray-50 border border-gray-100 shrink-0 relative flex items-center justify-center mx-auto sm:mx-0">
                        {autor.foto ? (
                          <img 
                            src={autor.foto.src} 
                            width={autor.foto.width} 
                            height={autor.foto.height} 
                            alt={autor.name}
                            class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                            loading="lazy"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center bg-[#005F6B]/5 text-[#005F6B]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                          </div>
                        )}
                      </div>
                      
                      <div class="text-center sm:text-left">
                        <h2 class="text-2xl font-bold text-[#002B30] tracking-tight group-hover:text-[#C5A880] transition-colors duration-300">
                          {autor.name}
                        </h2>
                        <p class="text-sm font-medium text-gray-400 mt-0.5">
                          {autor.role}
                        </p>
                        {autor.oab && (
                          <span class="inline-block mt-1 text-[11px] font-mono tracking-widest text-[#C5A880] bg-[#C5A880]/5 px-2 py-0.5 rounded">
                            {autor.oab}
                          </span>
                        )}
                      </div>
                    </div>

                    <p class="text-[15px] text-gray-500 leading-relaxed font-light mb-8 line-clamp-4 text-center sm:text-left">
                      {autor.bio}
                    </p>

                    {autor.especialidades.length > 0 && (
                      <div class="mb-8">
                        <span class="text-[11px] font-bold text-[#002B30] uppercase tracking-wider block mb-3 text-center sm:text-left">
                          Foco de Atuação:
                        </span>
                        <div class="flex flex-wrap justify-center sm:justify-start gap-2">
                          {autor.especialidades.map((tag) => (
                            <span class="px-3 py-1 bg-gray-50 text-gray-500 text-xs rounded-full border border-gray-100/60">
                              {tag}
                            </span>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>

                  <div class="pt-6 border-t border-gray-50 flex flex-col sm:flex-row gap-4 items-center justify-between mt-auto w-full">
                    <div class="flex items-center gap-3">
                      {autor.redes.linkedin && (
                        <a href={autor.redes.linkedin} target="_blank" rel="noopener noreferrer" class="w-9 h-9 sm:w-8 sm:h-8 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                        </a>
                      )}
                      {autor.redes.instagram && (
                        <a href={autor.redes.instagram} target="_blank" rel="noopener noreferrer" class="w-9 h-9 sm:w-8 sm:h-8 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                        </a>
                      )}
                      {autor.redes.email && (
                        <a href={autor.redes.email} class="w-9 h-9 sm:w-8 sm:h-8 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </a>
                      )}
                      {autor.redes.jusbrasil && (
                        <a href={autor.redes.jusbrasil} target="_blank" rel="noopener noreferrer" class="w-9 h-9 sm:w-8 sm:h-8 rounded-full bg-gray-50 flex items-center justify-center text-xs font-serif font-bold text-gray-400 hover:bg-[#002B30] hover:text-white transition-all duration-300" title="Jusbrasil">
                          Jb
                        </a>
                      )}
                    </div>

                    <a 
                      href={`/autores/${autor.slug}`} 
                      class="flex items-center gap-2 text-[13px] font-bold text-[#002B30] group-hover:text-[#C5A880] transition-all transform group-hover:translate-x-1"
                    >
                      <span>Perfil Completo</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>

                </div>
              ))}
            </div>
          )}
        </section>
      </div>
    </main>

    <Footer client:visible />
  </body>
</html>

<style is:global>
  :root {
    --accent: #C0B283;
  }
</style>

<script>
  const btnShare = document.getElementById("btn-share");
  if (btnShare) {
    btnShare.addEventListener("click", async () => {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
      } catch {
        navigator.clipboard.writeText(window.location.href);
        alert("Link do perfil copiado para a área de transferência!");
      }
    });
  }
</script>