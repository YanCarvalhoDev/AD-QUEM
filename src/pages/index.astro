---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero';
import EngineeringFoundation from '../components/EngineeringFoundation';
import Portfolio from '../components/Portfolio';
import ROISection from '../components/ROISection';
import SocialProof from '../components/SocialProof';
import MethodSection from '../components/MethodSection';
import FinalCTA from '../components/FinalCTA';
import Founder from '../components/Founder';
import FAQ from '../components/FAQ';
import ContactForm from '../components/ContactForm';
import ScrollAnimation from '../components/ScrollAnimation';
import { Image, getImage , Picture } from 'astro:assets';
import heroImg from '../assets/images/sp3.webp';
import heroImgMobile from '../assets/images/sp3m.webp';
import finalBg from '../assets/images/finalBg.webp';
import imgFounder1 from '../assets/images/Yan-Carvalho.webp';
import imgFounder2 from '../assets/images/mockup_site.webp';
import imgFounder3 from '../assets/images/diagrams.webp';
import imgFounder4 from '../assets/images/editorial.webp';
import imgFounder5 from '../assets/images/method4.webp';

import { FeaturedGrid } from '../components/FeaturedGrid';

const desktopImg = await getImage({ src: heroImg, width: 1024, format: 'webp' });
const mobileImg = await getImage({ src: heroImgMobile, width: 600, format: 'webp'});
---

<MainLayout title="Arquiteto Digital Jurídico - Home" isDarkPage={true} className="bg-teal-deep text-sandstone">
  <Hero >
     <picture class="w-full h-full">
      <!-- Imagem para Mobile -->
      <source 
        media="(max-width: 640px)" 
        srcset={mobileImg.src} 
      />
      <!-- Imagem para Desktop -->
      <img
        src={desktopImg.src}
        alt="Arquitetura corporativa moderna representando a solidez e prestígio jurídico"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover brightness-90"
        decoding="async"
      />
    </picture>
  </Hero>
  <EngineeringFoundation client:visible />
  <ROISection client:visible />
  <FeaturedGrid client:visible 
  links={{
    about: '/institucional/sobre',
    professionals: '/nossos-talentos',
    contact: '/fale-conosco',
    careers: '/trabalhe-conosco'
  }} 
/> 
    <!--<ScrollAnimation client:visible /> -->
 <!-- <Portfolio client:visible /> -->
  
   <!-- <SocialProof client:visible /> -->
  <MethodSection client:visible />
  <!-- <FinalCTA client:visible >
    <Image
      src={finalBg}
      alt="Arquitetura corporativa de alto padrão simbolizando o sucesso das bancas parceiras"
      widths={[400, 800, 1200, 1920]}
      sizes="100vw"
      loading="lazy"
      class="w-full h-full object-cover brightness-110 contrast-110"
    />
  </FinalCTA> -->
  <Founder client:visible={{ rootMargin: '1700px' }} >
      <Image 
      src={imgFounder1} 
      alt="Retrato em close-up de Yan Almeida de Carvalho (Yan Carvalho), criador da Ad Quem, com cabelo cacheado escuro, barba curta e terno escuro sobre blusa de gola alta, posando contra um fundo azul esverdeado iluminado por luz natural." 
      widths={[300, 600]} 
      sizes="(max-width: 768px) 300px, 600px"
      quality={70}
      class="w-full h-full object-cover grayscale brightness-90 hover:brightness-90 hover:grayscale-0 transition-all duration-700"
      slot="image1" 
    />
    <Image 
      src={imgFounder2} 
      alt="Notebook em cima de uma mesa de madeira exibindo na tela o site de advocacia de Nathalie Almeida, com texto em destaque e a foto de uma advogada sentada em seu escritório." 
      widths={[200, 400]} 
      sizes="(max-width: 768px) 200px, 400px"
      quality={70}
      class="w-full h-full object-cover grayscale contrast-110 brightness-75 hover:grayscale-0 transition-all duration-700"
      slot="image2" 
    />
    <Image 
      src={imgFounder3} 
      alt="Quadro de cortiça em um escritório moderno com post-its coloridos, papéis e fluxogramas organizados sobre etapas de desenvolvimento, como arquitetura de informação, UI/UX design e testes, acima de uma mesa de madeira limpa." 
      widths={[150, 300]} 
      sizes="(max-width: 768px) 150px, 300px"
      quality={60}
      class="w-full h-full object-cover grayscale contrast-125 brightness-50 hover:brightness-90 transition-all duration-700"
      slot="image3" 
    />
    <Image 
      src={imgFounder4} 
      alt="Vista superior de uma mesa branca minimalista da Ad Quem, organizada com um notebook preto fechado, cadernos, bloco de anotações com caneta preta, papéis impressos com diagramas e uma luminária de mesa preta articulada." 
      widths={[100, 200]} 
      sizes="100px"
      quality={50}
      class="w-full h-full object-cover grayscale brightness-50 group-hover:brightness-75 transition-all duration-700"
      slot="image4" 
    />
    <Image 
      src={imgFounder5} 
      alt="Corredor moderno de escritório com divisórias de vidro e estruturas metálicas pretas, piso cinza polido e salas com sofás e luminárias pendentes." 
      widths={[80, 160]} 
      sizes="80px"
      quality={50}
      class="w-full h-full object-cover grayscale brightness-[0.4] hover:brightness-75 transition-all duration-700"
      slot="image5" 
    />
  </Founder>
  <FAQ client:visible />
  <!-- <ContactForm client:visible /> -->
</MainLayout>
