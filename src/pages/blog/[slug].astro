<script>
  // [PDF] MODIFICADO: compartilhar.
  // Antes, cancelar o menu de compartilhamento (AbortError) caía no catch e mostrava
  // "Link copiado" sem o usuário pedir. Agora o cancelamento é ignorado.
  const btnShare = document.getElementById("btn-share");
  btnShare?.addEventListener("click", async () => {
    const url = window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, url });
        return;
      } catch (err) {
        if (err instanceof DOMException && err.name === "AbortError") return;
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      alert("Link copiado para a área de transferência!");
    } catch {
      alert(`Copie o link do artigo: ${url}`);
    }
  });

  // [PDF] NOVO: botão de PDF. Só abre a janela de impressão; o layout vem do CSS e do
  // beforeprint abaixo, por isso o resultado é idêntico ao Ctrl+P.
  document.getElementById("btn-print")?.addEventListener("click", () => window.print());

  // ======================================================
  // [PDF] NOVO: REORGANIZAÇÃO DO DOCUMENTO SÓ PARA A IMPRESSÃO
  // `beforeprint` dispara tanto no botão quanto no Ctrl+P. Tudo o que é movido aqui é
  // registrado e devolvido ao lugar no `afterprint`, então a página na tela não muda.
  // ======================================================

  // Compara títulos sem acento e sem diferença de maiúsculas.
  const normalizar = (texto: string) =>
    texto.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();

  // Títulos reconhecidos. Acrescente variações aqui se a equipe usar outros nomes.
  const RE_REFERENCIAS = /^(referencias|fontes|bibliografia|obras citadas)/;
  const RE_CONCLUSAO = /^(conclusao|conclusoes|consideracoes finais)/;

  type Movimento = { no: Node; pai: Node; proximo: Node | null };
  let movimentos: Movimento[] = [];
  let detailsAbertos: HTMLDetailsElement[] = [];

  const mover = (no: Node, destino: Node, antesDe: Node | null = null) => {
    if (!no.parentNode) return;
    movimentos.push({ no, pai: no.parentNode, proximo: no.nextSibling });
    destino.insertBefore(no, antesDe);
  };

  // Um título e tudo o que vem depois dele, até o próximo título de nível igual ou maior.
  const secaoAPartirDe = (titulo: Element) => {
    const nivel = Number(titulo.tagName.charAt(1));
    const elementos: Element[] = [titulo];
    let atual = titulo.nextElementSibling;
    while (atual) {
      if (/^H[1-6]$/.test(atual.tagName) && Number(atual.tagName.charAt(1)) <= nivel) break;
      elementos.push(atual);
      atual = atual.nextElementSibling;
    }
    return elementos;
  };

  const desfazerImpressao = () => {
    for (let i = movimentos.length - 1; i >= 0; i--) {
      const { no, pai, proximo } = movimentos[i];
      pai.insertBefore(no, proximo);
    }
    movimentos = [];

    detailsAbertos.forEach((details) => (details.open = false));
    detailsAbertos = [];

    document.getElementById("print-annex-frame")?.removeAttribute("data-preenchido");
  };

  const prepararImpressao = () => {
    // Evita aplicar duas vezes se o navegador disparar beforeprint repetido.
    if (movimentos.length || detailsAbertos.length) desfazerImpressao();

    const prose = document.querySelector(".conteudo-artigo .prose");
    const anexo = document.getElementById("print-annex");
    const moldura = document.getElementById("print-annex-frame");
    const faq = document.querySelector(".faq-section");
    if (!prose || !anexo || !moldura) return;

    const titulos = Array.from(prose.querySelectorAll("h2, h3"));

    // 1) Referências: vão para a folha separada, depois da conclusão e dos autores.
    const tituloReferencias = titulos.find((h) => RE_REFERENCIAS.test(normalizar(h.textContent ?? "")));
    if (tituloReferencias) {
      secaoAPartirDe(tituloReferencias).forEach((el) => mover(el, anexo));
    }

    // Notas de rodapé geradas pelo Markdown ([^1]) também vão para a folha de referências.
    const notas = prose.querySelector("section[data-footnotes], .footnotes");
    if (notas) mover(notas, anexo);

    if (anexo.childElementCount > 0) moldura.setAttribute("data-preenchido", "");

    // 2) FAQ antes da conclusão, para os autores ficarem logo abaixo dela.
    const tituloConclusao = titulos.find((h) => RE_CONCLUSAO.test(normalizar(h.textContent ?? "")));
    if (faq && tituloConclusao?.parentNode) {
      mover(faq, tituloConclusao.parentNode, tituloConclusao);
    }

    // 3) Abre os <details> do FAQ para as respostas saírem no PDF.
    detailsAbertos = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(".faq-section details:not([open])")
    );
    detailsAbertos.forEach((details) => (details.open = true));
  };

  window.addEventListener("beforeprint", prepararImpressao);
  window.addEventListener("afterprint", desfazerImpressao);
</script>
