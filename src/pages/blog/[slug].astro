</style>

<script>
  const btnShare = document.getElementById("btn-share");
  btnShare?.addEventListener("click", async () => {
    const url = window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, url });
        return;
      } catch (err) {
        if (err instanceof DOMException && err.name === "AbortError") return;
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      alert("Link copiado para a área de transferência!");
    } catch {
      alert(`Copie o link do artigo: ${url}`);
    }
  });

  document.getElementById("btn-print")?.addEventListener("click", () => window.print());

  const normalizar = (texto: string) =>
    texto.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();

  const RE_REFERENCIAS = /^(referencias|fontes|bibliografia|obras citadas)/;
  const RE_CONCLUSAO = /^(conclusao|conclusoes|consideracoes finais)/;

  type Movimento = { no: Node; pai: Node; proximo: Node | null };
  let movimentos: Movimento[] = [];
  let detailsAbertos: HTMLDetailsElement[] = [];

  const mover = (no: Node, destino: Node, antesDe: Node | null = null) => {
    if (!no.parentNode) return;
    movimentos.push({ no, pai: no.parentNode, proximo: no.nextSibling });
    destino.insertBefore(no, antesDe);
  };

  const secaoAPartirDe = (titulo: Element) => {
    const nivel = Number(titulo.tagName.charAt(1));
    const elementos: Element[] = [titulo];
    let atual = titulo.nextElementSibling;
    while (atual) {
      if (/^H[1-6]$/.test(atual.tagName) && Number(atual.tagName.charAt(1)) <= nivel) break;
      elementos.push(atual);
      atual = atual.nextElementSibling;
    }
    return elementos;
  };

  const desfazerImpressao = () => {
    for (let i = movimentos.length - 1; i >= 0; i--) {
      const { no, pai, proximo } = movimentos[i];
      pai.insertBefore(no, proximo);
    }
    movimentos = [];

    detailsAbertos.forEach((details) => (details.open = false));
    detailsAbertos = [];

    document.getElementById("print-annex-frame")?.removeAttribute("data-preenchido");
  };

  const prepararImpressao = () => {
    if (movimentos.length || detailsAbertos.length) desfazerImpressao();

    const prose = document.querySelector(".conteudo-artigo .prose");
    const anexo = document.getElementById("print-annex");
    const moldura = document.getElementById("print-annex-frame");
    const faq = document.querySelector(".faq-section");
    if (!prose || !anexo || !moldura) return;

    const titulos = Array.from(prose.querySelectorAll("h2, h3"));

    const tituloReferencias = titulos.find((h) => RE_REFERENCIAS.test(normalizar(h.textContent ?? "")));
    if (tituloReferencias) {
      secaoAPartirDe(tituloReferencias).forEach((el) => mover(el, anexo));
    }

    const notas = prose.querySelector("section[data-footnotes], .footnotes");
    if (notas) mover(notas, anexo);

    if (anexo.childElementCount > 0) moldura.setAttribute("data-preenchido", "");

    const tituloConclusao = titulos.find((h) => RE_CONCLUSAO.test(normalizar(h.textContent ?? "")));
    if (faq && tituloConclusao?.parentNode) {
      mover(faq, tituloConclusao.parentNode, tituloConclusao);
    }

    detailsAbertos = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(".faq-section details:not([open])")
    );
    detailsAbertos.forEach((details) => (details.open = true));
  };

  window.addEventListener("beforeprint", prepararImpressao);
  window.addEventListener("afterprint", desfazerImpressao);

  const iniciarSumario = (rail: HTMLElement, lista: HTMLElement) => {
    const desktop = window.matchMedia("(min-width: 1024px)");
    const reduzirMovimento = window.matchMedia("(prefers-reduced-motion: reduce)");

    const titulos = Array.from(
      document.querySelectorAll<HTMLHeadingElement>(
        ".conteudo-artigo .prose h2, .conteudo-artigo .faq-section > h2"
      )
    );
    if (!titulos.length) return;

    const criarId = (texto: string) => {
      const base = normalizar(texto).replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "secao";
      let id = base;
      let n = 2;
      while (document.getElementById(id)) id = `${base}-${n++}`;
      return id;
    };

    type Entrada = {
      titulo: HTMLHeadingElement;
      item: HTMLLIElement;
      link: HTMLAnchorElement;
      visivel: boolean;
      animacao: Animation | null;
    };

    const entradas: Entrada[] = titulos.map((titulo) => {
      if (!titulo.id) titulo.id = criarId(titulo.textContent ?? "");

      const item = document.createElement("li");
      item.className = "toc-rail__item";
      item.hidden = true;

      const link = document.createElement("a");
      link.className = "toc-rail__link";
      link.href = `#${titulo.id}`;
      link.textContent = (titulo.textContent ?? "").trim();

      link.addEventListener("click", (evento) => {
        evento.preventDefault();
        titulo.scrollIntoView({ behavior: reduzirMovimento.matches ? "auto" : "smooth", block: "start" });
        history.replaceState(null, "", `#${titulo.id}`);
      });

      item.append(link);
      lista.append(item);
      return { titulo, item, link, visivel: false, animacao: null };
    });

    const DURACAO_ENTRADA = 650;
    const DURACAO_SAIDA = 420;
    const ATRASO_ENTRE_ITENS = 70;
    const CURVA_ENTRADA = "cubic-bezier(0.22, 1, 0.36, 1)";
    const CURVA_SAIDA = "cubic-bezier(0.4, 0, 0.2, 1)";

    const posicaoDoTitulo = (entrada: Entrada) => {
      const origem = entrada.titulo.getBoundingClientRect();
      const destino = entrada.item.getBoundingClientRect();
      const tamanhoTitulo = parseFloat(getComputedStyle(entrada.titulo).fontSize);
      const tamanhoItem = parseFloat(getComputedStyle(entrada.link).fontSize);
      const escala = Math.min(1.8, Math.max(1, tamanhoTitulo / tamanhoItem || 1));
      const alturaTela = window.innerHeight;
      const dx = origem.left - destino.left;
      const dy = Math.max(-alturaTela, Math.min(alturaTela, origem.top - destino.top));
      return `translate(${dx}px, ${dy}px) scale(${escala})`;
    };

    let animacoesAtivas = 0;
    const acompanhar = (animacao: Animation) => {
      animacoesAtivas += 1;
      rail.classList.add("is-animando");
      let encerrada = false;
      const encerrar = () => {
        if (encerrada) return;
        encerrada = true;
        animacoesAtivas = Math.max(0, animacoesAtivas - 1);
        if (animacoesAtivas === 0) rail.classList.remove("is-animando");
      };
      animacao.addEventListener("finish", encerrar);
      animacao.addEventListener("cancel", encerrar);
      return animacao;
    };

    const mostrar = (entrada: Entrada, animar: boolean, atraso = 0) => {
      entrada.animacao?.cancel();
      entrada.animacao = null;
      entrada.visivel = true;
      entrada.item.hidden = false;
      if (!animar) return;

      entrada.animacao = acompanhar(
        entrada.item.animate(
          [
            { transform: posicaoDoTitulo(entrada), opacity: 0 },
            { transform: "none", opacity: 1 },
          ],
          { duration: DURACAO_ENTRADA, delay: atraso, easing: CURVA_ENTRADA, fill: "backwards" }
        )
      );
    };

    const esconder = (entrada: Entrada, animar: boolean) => {
      entrada.animacao?.cancel();
      entrada.animacao = null;
      entrada.visivel = false;
      if (!animar) {
        entrada.item.hidden = true;
        return;
      }

      const animacao = acompanhar(
        entrada.item.animate(
          [
            { transform: "none", opacity: 1 },
            { transform: posicaoDoTitulo(entrada), opacity: 0 },
          ],
          { duration: DURACAO_SAIDA, easing: CURVA_SAIDA, fill: "forwards" }
        )
      );
      entrada.animacao = animacao;
      animacao.onfinish = () => {
        if (entrada.animacao !== animacao) return;
        entrada.item.hidden = true;
        animacao.cancel();
        entrada.animacao = null;
      };
    };

    let linha = 0;
    const medirLinha = () => {
      linha = (parseFloat(getComputedStyle(titulos[0]).scrollMarginTop) || 120) + 24;
    };

    let animacaoLiberada = false;
    const liberarAnimacao = () => window.setTimeout(() => (animacaoLiberada = true), 150);
    if (document.readyState === "complete") liberarAnimacao();
    else window.addEventListener("load", liberarAnimacao, { once: true });

    let agendado = false;

    const atualizar = () => {
      agendado = false;
      const animar = animacaoLiberada && desktop.matches && !reduzirMovimento.matches;

      const passou = entradas.map((entrada) => entrada.titulo.getBoundingClientRect().top < linha);

      let atraso = 0;
      entradas.forEach((entrada, i) => {
        if (passou[i] && !entrada.visivel) {
          mostrar(entrada, animar, atraso);
          atraso += ATRASO_ENTRE_ITENS;
        } else if (!passou[i] && entrada.visivel) {
          esconder(entrada, animar);
        }
      });

      const atual = passou.lastIndexOf(true);
      entradas.forEach((entrada, i) => {
        if (i === atual) entrada.link.setAttribute("aria-current", "location");
        else entrada.link.removeAttribute("aria-current");
      });
      rail.classList.toggle("is-ativo", atual >= 0);
    };

    const agendar = () => {
      if (agendado) return;
      agendado = true;
      requestAnimationFrame(atualizar);
    };

    medirLinha();
    atualizar();
    window.addEventListener("scroll", agendar, { passive: true });
    window.addEventListener("resize", () => {
      medirLinha();
      agendar();
    });
    desktop.addEventListener("change", agendar);
  };

  const sumario = document.getElementById("toc-rail");
  const listaSumario = document.getElementById("toc-lista");
  if (sumario && listaSumario) iniciarSumario(sumario, listaSumario);
</script>
