---
// src/pages/blog/[slug].astro
import { getCollection, getEntry, render } from 'astro:content';
import { Share2, Printer, ArrowLeft } from 'lucide-react';
// [PDF] MODIFICADO: removidos os imports não utilizados (Clock, Calendar, Mail e MarkdownImage).
// Printer voltou a ser usado porque o botão de PDF foi reativado.

// Importações cruciais para o estilo e estrutura da AdQuem
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ProgressIndicator from '../../components/ProgressIndicator';
import '../../styles/global.css';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos');
  return artigos.map((artigo) => ({
    params: { slug: artigo.id },
    props: { artigo },
  }));
}

const { artigo } = Astro.props;

if (!artigo) {
  return Astro.redirect('/404');
}

const {
  title,
  subtitle,
  date,
  readingTime,
  quote,
  authors,
  category,
  tags,
  perguntasRapidas,
} = artigo.data;

const { Content } = await render(artigo);

const dadosCategoria = category
  ? await getEntry('categorias', category)
  : null;

const dadosAutores = authors
  ? await Promise.all(
      authors.map((authorSlug) =>
        getEntry('autores', authorSlug).catch(() => null)
      )
    )
  : [];

// [PDF] NOVO: lista de autores válidos calculada uma única vez.
// Antes o template repetia `dadosAutores.filter(...)` em vários pontos; agora a tela,
// o PDF e o schema usam a mesma lista, já tipada sem null/undefined.
const autoresValidos = dadosAutores.filter(
  (autor): autor is NonNullable<(typeof dadosAutores)[number]> => Boolean(autor?.data)
);
const rotuloAutores = autoresValidos.length === 1 ? 'Autor' : 'Autores';

// [PDF] NOVO: nomes em uma linha, no padrão do português ("A, B e C"), para o topo do PDF.
const nomesAutores = new Intl.ListFormat('pt-BR', {
  style: 'long',
  type: 'conjunction',
}).format(autoresValidos.map((autor) => autor.data.name));

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.adquem.com.br');

const dataFormatada = date
  ? new Intl.DateTimeFormat('pt-BR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(date))
  : '';

// ======================================================
// ✅ RESOLUÇÃO LIMPA E INDEPENDENTE PARA PRODUÇÃO
// ======================================================

const SITE_URL = 'https://www.adquem.com.br';

const heroImage = artigo.data.heroImage;

const fallbackOgImage = new URL('/og-image.jpg', SITE_URL).href;

const getImageSrc = (image: unknown): string | undefined => {
  if (typeof image === 'string') {
    return image.trim() || undefined;
  }

  if (image && typeof image === 'object' && 'src' in image) {
    const src = image.src;

    if (typeof src === 'string' && src.trim()) {
      return src;
    }
  }

  return undefined;
};

const getAbsoluteImageUrl = (
  src: string | undefined
): string | undefined => {
  if (!src) return undefined;

  try {
    const url = new URL(src, SITE_URL);

    if (url.protocol !== 'https:' && url.protocol !== 'http:') {
      return undefined;
    }

    return url.href;
  } catch {
    return undefined;
  }
};

// ======================================================
// [PDF] NOVO: CONFIGURAÇÃO DO DOCUMENTO IMPRESSO
// ======================================================
// Logo em /public.
const PRINT_LOGO_SRC = '/AQ_Ad_Quem_logo.png';

// [PDF] MODIFICADO: a cor agora é aplicada por um filtro SVG sobre um <img> comum (antes era
// mask-image em CSS). O <img> é baixado junto com a página, então a logo já está pronta quando
// o PDF é gerado; a máscara CSS só era pedida na hora de imprimir e podia sair em branco.
// O filtro pinta o desenho da logo usando a transparência do PNG. Se o arquivo tiver FUNDO
// SÓLIDO (não transparente), coloque `false`: a logo sai com as cores originais e a marca
// d'água em escala de cinza, em vez de virar um retângulo colorido.
const PRINT_LOGO_TINGIR = true;

// Cores disponíveis para a logo do topo.
const COR_DOURADO = '#C5A880';
const COR_VERDE_LUXURY = '#002B30'; // confirme se este é o hex exato do "verde luxury" da marca
const PRINT_LOGO_COR = COR_DOURADO; // troque para COR_VERDE_LUXURY se preferir

// Cinza da marca d'água.
const COR_MARCA_DAGUA = '#7A7A7A';

// Logo colorida centralizada no topo da primeira página (papel timbrado).
const PRINT_LOGO_NO_TOPO = true;

// Marca d'água: a mesma logo, em cinza, ocupando 90% da largura no centro de TODAS as páginas.
const PRINT_MARCA_DAGUA = true;

// URL repetida no rodapé de todas as páginas.
const urlImpressao = canonicalURL.href;

// [PDF] NOVO: formata a OAB sem duplicar o prefixo caso o campo já venha como "OAB/SP 123.456".
const formatarOAB = (oab: string) => (/^oab/i.test(oab.trim()) ? oab.trim() : `OAB ${oab.trim()}`);

// [PDF] NOVO: aceita LinkedIn cadastrado com ou sem "https://".
const normalizarUrl = (url: string) =>
  /^https?:\/\//i.test(url.trim()) ? url.trim() : `https://${url.trim().replace(/^\/+/, '')}`;

// [PDF] NOVO: versão curta do link do LinkedIn, impressa no bloco do autor.
const encurtarUrl = (url: string) =>
  url.replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/+$/, '');

// [PDF] MODIFICADO: QR code removido. O bloco de autores mantém foto, nome, cargo, OAB e o
// link curto do LinkedIn; por isso a biblioteca `qrcode` não é mais necessária.
const autoresPdf = autoresValidos.map((autor) => ({
  autor,
  foto: getImageSrc(autor.data.image),
  linkedinUrl: autor.data.linkedin ? normalizarUrl(autor.data.linkedin) : null,
}));

const heroImageSrc = getImageSrc(heroImage);
const heroImageUrl = getAbsoluteImageUrl(heroImageSrc);

const ogImage = heroImageUrl ?? fallbackOgImage;

const heroImageAlt =
  heroImage &&
  typeof heroImage === 'object' &&
  'alt' in heroImage &&
  typeof heroImage.alt === 'string'
    ? heroImage.alt
    : title;


const dataISO = date ? new Date(date).toISOString() : new Date().toISOString();

const metaTitle = `${title} | AdQuem`;
const metaDescription = subtitle ?? `Leia o artigo "${title}" publicado pela AdQuem.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": metaDescription,
  "image": [ogImage],
  "datePublished": dataISO,
  "dateModified": dataISO,
  // [PDF] MODIFICADO: usa `autoresValidos` (mesma lista do PDF), em vez de filtrar de novo.
  "author": autoresValidos.map((autor) => {
      const data = autor.data;

      // sameAs recebe apenas links de perfis/redes sociais
      const redesSociais = [
        data.linkedin,
        data.instagram,
        data.jusbrasil
      ].filter(Boolean);

      // Limpa os caracteres e garante o formato padrão internacional: +5511999999999
      const apenasNumeros = data.whatsapp ? data.whatsapp.replace(/\D/g, '') : '';
      const telefoneFormatado = apenasNumeros ? `+55${apenasNumeros}` : '';

      return {
        "@type": "Person",
        "name": data.name,
        "jobTitle": data.role || "Autor",

        ...(data.bio && { "description": data.bio }),
        ...(data.email && { "email": data.email }),

        ...(data.knowsAbout && data.knowsAbout.length > 0 && { "knowsAbout": data.knowsAbout }),

        // WhatsApp entra como um canal de telefone puro e padronizado
        ...(telefoneFormatado && { "telephone": telefoneFormatado }),

        ...(redesSociais.length > 0 && { "sameAs": redesSociais }),

        ...(data.oab && {
          "identifier": {
            "@type": "PropertyValue",
            "name": "OAB",
            "value": data.oab
          }
        })
      };
    }),
  "publisher": {
    "@type": "Organization",
    "name": "AdQuem",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.adquem.com.br/logo.png",
    },
  },
  "articleSection": dadosCategoria?.data.name,
  "keywords": tags?.join(", "),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
  "url": canonicalURL.href,
  "inLanguage": "pt-BR",
  "isAccessibleForFree": true,
  ...(perguntasRapidas && perguntasRapidas.length > 0 && {
    "mainEntity": {
      "@type": "FAQPage",
      "mainEntity": perguntasRapidas.map((item) => ({
        "@type": "Question",
        "name": item.pergunta,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.resposta
        }
      }))
    }
  })
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link
      rel="preload"
      href="/fonts/inter-v20-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-v5-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {tags && tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="AdQuem" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  {/* body com as classes originais do seu Layout combinadas com as do seu Artigo */}
  <body class="min-h-screen selection:bg-gold-pale selection:text-teal-deep bg-teal-deep">

    {/* [PDF] MODIFICADO: ProgressIndicator e Header dentro de um wrapper .no-print.
        Antes a ocultação dependia de seletores genéricos (header, nav, section, aside), que
        também podiam apagar elementos do próprio artigo. */}
    <div class="no-print">
      <ProgressIndicator client:idle />
      <Header isDarkPage={true} client:idle />
    </div>

    {/* [PDF] NOVO: filtros SVG que pintam a logo (dourado/verde no topo, cinza na marca d'água).
        Ficam num SVG de tamanho zero; não podem usar display:none, senão o navegador ignora o
        filtro. `in` com SourceAlpha mantém só o desenho da logo e troca a cor dele. */}
    {PRINT_LOGO_TINGIR && (
      <svg class="print-filters" width="0" height="0" aria-hidden="true" focusable="false">
        <filter id="aq-logo-cor" color-interpolation-filters="sRGB">
          <feFlood flood-color={PRINT_LOGO_COR} />
          <feComposite in2="SourceAlpha" operator="in" />
        </filter>
        <filter id="aq-logo-cinza" color-interpolation-filters="sRGB">
          <feFlood flood-color={COR_MARCA_DAGUA} />
          <feComposite in2="SourceAlpha" operator="in" />
        </filter>
      </svg>
    )}

    {/* [PDF] MODIFICADO: marca d'água maior e visível: 90% da largura da folha, em cinza, no
        centro de cada página (position: fixed se repete em todas as páginas impressas) e ATRÁS
        do texto. Antes tinha 95 mm e 7% de opacidade, praticamente invisível no PDF. */}
    {PRINT_MARCA_DAGUA && (
      <div class:list={['print-watermark', { 'print-watermark--tingida': PRINT_LOGO_TINGIR }]} aria-hidden="true">
        <img src={PRINT_LOGO_SRC} alt="" decoding="async" fetchpriority="low" />
      </div>
    )}

    {/* [PDF] NOVO: rodapé do documento com o link do artigo, repetido no fim de TODAS as
        páginas (position: fixed). O espaço dele é reservado pelo <tfoot> da moldura,
        então nunca fica por cima do texto. */}
    <div class="print-running-footer" aria-hidden="true">
      <span class="print-running-footer__brand">Ad Quem</span>
      <span class="print-running-footer__url">{urlImpressao}</span>
    </div>

      <div class="min-h-screen bg-white font-sans selection:bg-[#E6F4F6] text-black">
        <main class="pb-40">

          {/* Header do Artigo (Estilo Quiet Luxury / Teal) */}
          <div class="bg-[#002B30] pt-24 pb-0 mb-6 md:mb-20 relative overflow-hidden print:hidden no-print">
            <div class="absolute top-0 right-0 w-1/3 h-full bg-[#C5A880]/5 blur-[120px] rounded-full translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
            <div class="container mx-auto max-w-7xl px-6 lg:px-20 relative z-10">
              <nav class="flex items-center justify-between border-b border-white/15 pb-4">
                <a href="/blog" class="flex items-center gap-2.5 text-white hover:text-[#C5A880] transition-colors group">
                  <ArrowLeft size={16} class="group-hover:-translate-x-1.5 transition-transform" />
                  <span class="text-[12px] font-bold uppercase tracking-[0.2em]">
                    Voltar para Insights
                  </span>
                </a>

                <div class="flex items-center gap-6 text-white/60">
                  <button type="button" class="hover:text-white transition-colors" title="Compartilhar" aria-label="Compartilhar artigo" id="btn-share">
                    <Share2 size={18} />
                  </button>

                  {/* [PDF] MODIFICADO: botão de PDF reativado. Só chama window.print(); o layout
                      vem 100% do CSS @media print e do evento beforeprint, então o Ctrl+P gera
                      exatamente o mesmo documento. */}
                  <button type="button" class="hover:text-white transition-colors" title="Salvar em PDF ou imprimir" aria-label="Salvar artigo em PDF ou imprimir" id="btn-print">
                    <Printer size={18} />
                  </button>
                </div>
              </nav>
            </div>
          </div>

          {/* [PDF] NOVO: moldura de impressão.
              O @page usa margem 0 para que o navegador NÃO imprima o cabeçalho e o rodapé
              automáticos dele (data, título da aba, URL do navegador e paginação).
              As margens de cima e de baixo de CADA folha vêm do <thead> e do <tfoot> vazios,
              que os navegadores repetem em todas as páginas; as laterais vêm do padding da
              célula. Na tela, a tabela vira blocos comuns e não altera o layout. */}
          <table class="print-frame" role="presentation">
            <thead class="print-frame__margin" aria-hidden="true"><tr><td></td></tr></thead>
            <tbody>
              <tr>
                <td>

          <article class="container mx-auto max-w-7xl px-6 lg:px-20">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-16">

              {/* Rail Lateral de Metadados */}
              {/* [PDF] MODIFICADO: .no-print explícito (antes era escondido pela tag `aside`). */}
<aside class="contents lg:block lg:col-span-3 lg:space-y-12 no-print">
  <div class="space-y-1">

    <!-- Data de publicação -->
    <div class="pt-0">
      <div>
        <p class="text-[12px] font-bold text-gray-600 uppercase tracking-[0.25em] mb-0">
          Publicado em <span>{dataFormatada}</span>
        </p>
      </div>
    </div>

    <!-- Autores -->
    {autoresValidos.length > 0 && (
      <div class="hidden lg:block border-t border-gray-100 pt-8">
        <p class="text-[12px] font-bold text-gray-600 uppercase tracking-[0.25em] mb-6">
          {rotuloAutores}
        </p>

        <div class="space-y-6">
          {autoresValidos.map((autor) => {
            const foto = getImageSrc(autor.data.image);
            return (
              <div class="group">
                <div class="flex items-center gap-4">
                  {foto && (
                    <img
                      src={foto}
                      alt={autor.data.name}
                      class="w-14 h-14 rounded-full object-cover object-top grayscale group-hover:grayscale-0 transition-all shadow-sm shrink-0"
                    />
                  )}

                  <div class="space-y-0.5">
                    <a
                      href={`/autores/${autor.id}`}
                      class="block hover:underline decoration-[#C5A880] underline-offset-2"
                    >
                      <p class="text-sm lg:text-base font-bold text-[#002B30] group-hover:text-[#C5A880] transition-colors leading-tight">
                        {autor.data.name}
                      </p>
                    </a>

                    <p class="text-xs text-gray-600 tracking-wider font-light">
                      {autor.data.role}
                    </p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

  </div>
</aside>

              {/* Conteúdo Principal */}
              <div class="lg:col-span-9 conteudo-artigo">
                {/* [PDF] MODIFICADO: classe .article-header para o PDF tratar a abertura como
                    cabeçalho institucional centralizado, com filete separando do corpo. */}
                <div class="md:mb-14 mb-0 article-header">

                  {/* [PDF] NOVO: topo do documento, só no PDF: logo com máscara de cor +
                      categoria, data e tempo de leitura em uma linha. */}
                  <div class="print-only print-masthead">
                    {/* [PDF] MODIFICADO: logo do topo virou <img> real (antes era um <div> com
                        mask-image, que não aparecia no PDF). Carregamento normal (não lazy) e
                        prioridade baixa: já está pronta na hora de imprimir sem pesar no LCP. */}
                    {PRINT_LOGO_NO_TOPO && (
                      <img
                        src={PRINT_LOGO_SRC}
                        alt="Ad Quem"
                        class:list={['print-masthead__logo', { 'print-masthead__logo--tingida': PRINT_LOGO_TINGIR }]}
                        decoding="async"
                        fetchpriority="low"
                      />
                    )}
                    <p class="print-masthead__meta">
                      {dadosCategoria && <span>{dadosCategoria.data.name}</span>}
                      {dataFormatada && <span>Publicado em {dataFormatada}</span>}
                      {readingTime && <span>Leitura de {readingTime}</span>}
                    </p>
                  </div>

                  {dadosCategoria && (
                    <span class="inline-block text-[10px] font-bold text-[#005F6B] uppercase tracking-[0.3em] mb-6 print:hidden no-print">
                      {dadosCategoria.data.name.toUpperCase()}
                    </span>
                  )}

                  <h1 class="text-4xl lg:text-[56px] font-bold text-[#002B30] leading-[1.1] tracking-wide mb-8">
                    {title}
                  </h1>

                  {/* [PDF] NOVO: autores no começo, em UMA linha ("Por A, B e C"), abaixo do título. */}
                  {autoresValidos.length > 0 && (
                    <p class="print-only print-byline">
                      Por <strong>{nomesAutores}</strong>
                    </p>
                  )}

                  {/* [PDF] MODIFICADO: imagem de capa marcada como .no-print (o PDF sai sem imagem). */}
                  {
  artigo.data.heroImage?.src && (
    <figure class="my-10 article-hero no-print">
      <img
        src={
          typeof artigo.data.heroImage.src === "string"
            ? artigo.data.heroImage.src
            : artigo.data.heroImage.src.src
        }
        alt={artigo.data.heroImage.alt || title}
        class="w-full h-auto max-h-[180px] sm:max-h-[260px] md:max-h-[320px] object-cover rounded-2xl"
        loading="eager"
        decoding="async"
      />
    </figure>
  )
}

                  {/* [PDF] MODIFICADO: classe .print-lead para o subtítulo virar linha fina no PDF. */}
                  {subtitle && (
                    <p class="text-lg lg:text-xl text-black leading-relaxed font-light mb-8 border-b border-gray-100 pb-6 print-lead">
                      {subtitle}
                    </p>
                  )}
                </div>

                {quote && (
                  <blockquote class="border-l-4 border-[#C5A880] italic pl-6 text-xl my-8 text-gray-700 leading-relaxed font-serif">
                    "{quote}"
                  </blockquote>
                )}

                <div
  class="prose max-w-none text-black text-lg leading-[1.8] break-words overflow-hidden md:overflow-visible
  [&_p]:text-black
  [&_p]:font-normal
  [&_p]:mb-8
  [&_p]:leading-[1.8]
  [&_strong]:text-black
  [&_strong]:font-bold
  [&_blockquote]:border-l-4
  [&_blockquote]:border-[#C5A880]
  [&_blockquote]:pl-6
  [&_blockquote]:my-10
  [&_blockquote]:text-[1.375rem]
  [&_blockquote]:text-gray-700
  [&_blockquote]:italic
  [&_blockquote]:font-serif
  [&_blockquote]:leading-relaxed
  [&_h2]:text-[#002B30]
  [&_h2]:font-bold
  [&_h2]:leading-wide
  [&_h2]:mt-14
  [&_h2]:mb-6
  [&_h2]:text-3xl
  [&_h3]:text-[#005F6B]
  [&_h3]:font-bold
  [&_h3]:mt-12
  [&_h3]:mb-6
  [&_h3]:text-2xl
  [&_h4]:text-[#005F6B]
  [&_h4]:font-bold
  [&_h4]:mt-10
  [&_h4]:mb-4
  [&_h4]:text-xl
  [&_ul]:list-disc
  [&_ul]:pl-6
  [&_ul]:mb-8
  [&_ol]:list-decimal
  [&_ol]:pl-6
  [&_ol]:mb-8
  [&_img]:rounded-2xl
  [&_img]:my-8
  [&_img]:w-[70%]
  [&_img]:mx-auto
  [&_img]:h-auto
  [&_pre]:max-w-full
  [&_pre]:overflow-x-auto
  [&_table]:block
  [&_table]:overflow-x-auto
  [&_table]:table
  [&_table]:mx-auto
  [&_table]:my-8"

>
  <Content />
</div>

{/* Seção de Esclarecimentos Diretos (FAQ) */}
{/* [PDF] MODIFICADO: classe .faq-section. No PDF, o script:
    1) abre todos os <details> (fechados, as respostas não saíam);
    2) move o FAQ para ANTES do título "Conclusão", para que a conclusão seja o último
       bloco do texto e os autores fiquem logo abaixo dela. Depois da impressão, tudo volta
       ao lugar original. */}
{perguntasRapidas && perguntasRapidas.length > 0 && (
  <div class="mt-14 pt-10 border-t border-gray-100 faq-section">
    <h2 class="text-2xl font-bold text-[#002B30] mb-6 tracking-wide">
      Esclarecimentos
    </h2>
    <div class="space-y-4">
      {perguntasRapidas.map((item) => (
        <details class="group border border-gray-100 bg-gray-50/50 rounded-2xl p-5 [&_summary::-webkit-details-marker]:hidden transition-all duration-300 open:bg-white open:border-gray-200">
          <summary class="flex items-center justify-between font-semibold text-lg text-[#002B30] cursor-pointer list-none select-none gap-4">
            <span>{item.pergunta}</span>
            {/* [PDF] MODIFICADO: ícone marcado como .no-print e xmlns corrigido
